# Local development only. Copy to .env and fill in local/development credentials.
# Never commit .env or enter production secrets in this file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_DEVELOPMENT_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_DEVELOPMENT_KEY
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5500,http://localhost:5500
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Backend-only provider credentials. Keep real values out of source control.
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Use only documented hosting proxy IPs/CIDRs; an empty value trusts no proxy.
TRUSTED_PROXY_IPS=
# Optional dedicated HMAC key for shared rate-limit identities.
RATE_LIMIT_HASH_KEY=

# Optional. When unset, the Clerk SDK retrieves the JWKS using the secret key.
CLERK_JWT_KEY=

# Private admin allowlist: exact Clerk user IDs separated by commas; empty denies all.
ENROLLMENT_ADMIN_CLERK_USER_IDS=
